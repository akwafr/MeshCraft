# Copy to .env and adapt. docker compose reads .env automatically.

# Public domain served by Caddy (automatic Let's Encrypt certificate).
# Must point at this machine; ports 80/443 must be reachable.
MESHCRAFT_DOMAIN=localhost

# Full public URL of the controller: used to generate proxy docker-compose
# files, integrated registry image references, and migration orders.
MESHCRAFT_EXTERNAL_URL=http://localhost:8080

# ACME contact (certificate expiry, Let's Encrypt notices).
ACME_EMAIL=admin@example.com

# Initial administrator account (created on first start only).
MESHCRAFT_ADMIN_EMAIL=admin@meshcraft.local
# Empty = password is generated and printed once in the logs.
MESHCRAFT_ADMIN_PASSWORD=

# Encryption key for the credentials vault — fleet admin passwords,
# SNMP communities, SNMPv3 identities, and the full rotation history
# (64 hex characters; generate with: openssl rand -hex 32).
#
# Empty = a random key is drawn and STORED IN THE DATABASE next to the
# secrets it protects: enough to avoid plaintext, not enough against a
# dump leak.
#
# WARNING — ON AN INSTANCE ALREADY IN SERVICE, SETTING THIS VARIABLE IS
# NOT ENOUGH. Secrets already in the database are sealed with the old key:
# the new one would not open them. The controller therefore refuses to
# start and explains what to do, rather than appearing to work while
# losing monitoring and fleet access one screen at a time.
#
# Re-keying re-encrypts the vault in a single transaction:
#
#   1. back up the database: docker compose exec -T db pg_dump -U meshcraft meshcraft | gzip > before-rekey.sql.gz
#   2. store the new key IN YOUR SECRETS VAULT, then set it here;
#   3. stop the controller: docker compose stop controller
#   4. re-encrypt:          docker compose run --rm controller -rekey
#   5. restart:             docker compose up -d controller
#
# After re-keying, this key is the ONLY way to read this database's
# secrets: re-encryption drops the old key, and no copy remains on the
# server. Losing it means losing the vault.
MESHCRAFT_SECRET_KEY=
